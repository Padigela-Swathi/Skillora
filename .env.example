# ── Browser-safe (NEXT_PUBLIC_*): shipped to the client. Never put secrets here. ──────────────
# Supabase project URL, e.g. https://<ref>.supabase.co          (required; Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable (anon) key — safe for the browser, protected by RLS (required; same page)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public site origin used for the Google OAuth redirect, e.g. https://skillora.netlify.app (required in production; defaults to window origin locally)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Contact address shown in the Privacy Policy (required before launch)
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Server-only: set these as Supabase Edge Function secrets, NOT in Netlify / the browser. ────
# (Dashboard → Edge Functions → Secrets, or `supabase secrets set NAME=value`)
#   NVIDIA_API_KEY            required  NVIDIA API key (build.nvidia.com) for question generation + evaluation
#   NVIDIA_MODEL              optional  default google/gemma-4-31b-it
#   NVIDIA_FALLBACK_MODEL     optional  comma-separated chain, default poolside/laguna-xs-2.1,stepfun-ai/step-5-preview,nvidia/nemotron-3.5-bolt-e4b
#   JUDGE0_URL                optional  default https://ce.judge0.com (free public). Set to your own Judge0 for higher limits
#   JUDGE0_AUTH_TOKEN         optional  only if your Judge0 requires X-Auth-Token
#   ALLOWED_ORIGINS           optional  comma-separated site origins allowed by CORS (default *)
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected into Edge Functions automatically.

# ── Tests only (never deploy these) ───────────────────────────────────────────────────────────
# E2E_EMAIL_A=e2e-a@skillora-test.invalid
# E2E_EMAIL_B=e2e-b@skillora-test.invalid
# E2E_PASSWORD=             password used in tests/e2e/seed.sql
# LIVE_TESTS=1              enable tests/live (real NVIDIA + Judge0 calls)
